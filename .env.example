# Скопируйте в .env и заполните
TZ=Europe/Moscow
N8N_HOST=localhost
N8N_PROTOCOL=http
# Публичный адрес: нужен Telegram-триггеру (только https). Локально можно поднять туннель: ngrok http 5678
WEBHOOK_URL=https://your-domain.example.com/
# Любая длинная случайная строка, ей шифруются ключи в базе n8n
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
