    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"client_name\": \"Кафе «Ромашка», Ирина\",\n  \"phone\": \"+79991234567\",\n  \"summary\": \"Заказ кофе и сиропов с доставкой на завтра\",\n  \"items\": \"Кофе зерновой 1 кг x 10; Сироп ваниль x 4\",\n  \"category\": \"заказ\",\n  \"urgency\": \"средняя\",\n  \"sentiment\": \"нейтрально\",\n  \"reply\": \"Спасибо, Ирина! Заявку приняли, менеджер свяжется с вами в ближайшее время.\"\n}"
      },
      "id": "a9d3e60e-10e3-40ad-9e20-6e889d59efd5",
      "name": "Схема ответа",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "60ac42a8-f1ae-4d87-a3d1-a33de9d7a284",
      "name": "Объединить с заявкой",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1040,
        130
      ]
    },
    {
      "parameters": {
        "jsCode": "// Собираем строку для таблицы: исходные данные заявки + то, что извлекла нейросеть\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const ai = j.output || {};\n  const clean = (v) => (typeof v === 'string' ? v.trim() : '');\n  // телефон: если нейросеть не нашла, пробуем вытащить регуляркой из текста\n  let phone = clean(ai.phone) || clean(j.phone);\n  if (!phone) {\n    const m = (j.text || '').match(/(\\+7|8)[\\s\\-()]*\\d{3}[\\s\\-()]*\\d{3}[\\s\\-]*\\d{2}[\\s\\-]*\\d{2}/);\n    if (m) phone = m[0];\n  }\n  const digits = phone.replace(/\\D/g, '');\n  if (digits.length === 11) phone = '+7' + digits.slice(1);\n  const allowed = { category: ['заказ','вопрос','жалоба','сотрудничество','другое'],\n                    urgency: ['высокая','средняя','низкая'],\n                    sentiment: ['позитив','нейтрально','негатив'] };\n  const pick = (k, def) => allowed[k].includes(clean(ai[k])) ? clean(ai[k]) : def;\n  const row = {\n    'ID': 'L-' + DateTime.now().toFormat('yyMMdd-HHmmss') + '-' + Math.floor(Math.random()*90+10),\n    'Дата': DateTime.now().setZone('Europe/Moscow').toFormat('dd.MM.yyyy HH:mm'),\n    'Источник': j.source,\n    'Клиент': clean(ai.client_name) || clean(j.name) || '—',\n    'Телефон': phone,\n    'Контакт': j.contact || '',\n    'Суть': clean(ai.summary),\n    'Позиции': clean(ai.items),\n    'Категория': pick('category', 'другое'),\n    'Срочность': pick('urgency', 'низкая'),\n    'Тон': pick('sentiment', 'нейтрально'),\n    'Текст заявки': j.text,\n    'Статус': 'новая',\n    // служебные поля для ответа клиенту (в таблицу не пишутся)\n    _chat_id: j.chat_id || '',\n  };\n  const reply = clean(ai.reply) || 'Спасибо! Заявку получили, менеджер скоро с вами свяжется.';\n  // готовые тексты для Telegram (HTML, пользовательский текст экранируется)\n  row._manager_text = [\n    `🔥 <b>Срочная заявка</b> ${row['ID']}`, '',\n    `<b>Клиент:</b> ${esc(row['Клиент'])}`,\n    `<b>Телефон:</b> ${esc(row['Телефон'] || 'не указан')}`,\n    `<b>Категория:</b> ${row['Категория']} · ${row['Тон']}`,\n    `<b>Суть:</b> ${esc(row['Суть'])}`,\n    row['Позиции'] ? `<b>Позиции:</b> ${esc(row['Позиции'])}` : '',\n    '', `<i>Источник: ${esc(row['Источник'])} ${esc(row['Контакт'])}</i>`,\n  ].filter((l, i, a) => !(l === '' && a[i - 1] === '')).join('\\n');\n  row._reply = reply;\n  row._reply_text = `${esc(reply)}\\n\\nНомер заявки: <b>${row['ID']}</b>`;\n  out.push({ json: row });\n}\nreturn out;"
      },
