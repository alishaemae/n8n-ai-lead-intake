      "id": "d8c7f3e5-646d-4473-b108-d1086e27db09",
      "name": "Модель (DeepSeek / OpenAI)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        660,
        300
